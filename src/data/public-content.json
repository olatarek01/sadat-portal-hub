  "faqs": [
    {
      "answer_ar": "شهادة الثانوية العامة الأصلية، صورة بطاقة الرقم القومي أو شهادة الميلاد، 6 صور شخصية، ونموذج 2 جند لمن يلزم.",
      "answer_en": "Original secondary certificate, national ID or birth certificate copy, 6 photos, and military form when applicable.",
      "created_at": "2026-09-11T20:21:24.426624+00:00",
      "id": "17e14ff1-6670-462c-9232-64d7d9a68bc3",
      "published": true,
      "question_ar": "ما الأوراق المطلوبة للالتحاق؟",
      "question_en": "Which documents are required?",
      "sort_order": 2,
      "updated_at": "2026-09-11T20:21:24.426624+00:00"
    },
    {
      "answer_ar": "يفتح باب التقديم عادةً في أغسطس من كل عام ويستمر حتى منتصف سبتمبر عبر بوابة القبول الإلكترونية.",
      "answer_en": "Applications usually open in August and run until mid-September through the online admissions portal.",
      "created_at": "2026-09-11T20:21:24.426624+00:00",
      "id": "cd3913bb-2e88-4b6e-9222-1abdcc9e1252",
      "published": true,
      "question_ar": "ما هي مواعيد التقديم للعام الجامعي؟",
      "question_en": "When does admission open?",
      "sort_order": 3,
      "updated_at": "2026-09-12T16:55:05.394915+00:00"
    },
    {
      "answer_ar": "تتوفر المدينة الجامعية للطلاب من خارج المحافظة وللطلاب الوافدين وفق الأماكن المتاحة سنويًا.",
      "answer_en": "Campus housing is available for out-of-governorate and international students subject to yearly capacity.",
      "created_at": "2026-09-11T20:21:24.426624+00:00",
      "id": "943fa266-7376-48b3-b8d7-8f6c67e03f5e",
      "published": true,
      "question_ar": "هل يوجد سكن جامعي للطلاب الوافدين؟",
      "question_en": "Is student housing available?",
      "sort_order": 4,
      "updated_at": "2026-09-11T20:21:24.426624+00:00"
    },
    {
      "answer_ar": "بعد الإرسال يظهر رقم مرجعي للطلب، ويتم التواصل معك عبر البريد الإلكتروني أو الهاتف المسجل.",
      "answer_en": "After submission you receive a reference number, and the admissions office contacts you by email or phone.",
      "created_at": "2026-09-11T20:21:24.426624+00:00",
      "id": "025d61b4-3cd3-4165-a2b5-d8bca28c86bd",
      "published": true,
      "question_ar": "كيف أتابع حالة طلب الالتحاق؟",
      "question_en": "How do I track my application?",
      "sort_order": 5,
      "updated_at": "2026-09-11T20:21:24.426624+00:00"
    },
    {
      "answer_ar": "يتم التحويل وفق قواعد المجلس الأعلى للجامعات وتوافر الأماكن وتقارب المجموع الاعتباري.",
      "answer_en": "Transfers follow Supreme Council of Universities rules, available seats and comparable scores.",
      "created_at": "2026-09-11T20:21:24.426624+00:00",
      "id": "4eae2d5a-ebd8-4e88-9c32-0045cabf2d70",
      "published": true,
      "question_ar": "ما هي شروط التحويل بين الكليات؟",
      "question_en": "What are the transfer conditions?",
      "sort_order": 6,
      "updated_at": "2026-09-11T20:21:24.426624+00:00"
    }
  ],
